---
import type { GitHubUserProfile } from '../lib/github';
import type { ProfileData } from '../types';
import profileData from '../data/profile.json';

interface Props {
  user: GitHubUserProfile;
  profile?: ProfileData;
}

const { user, profile = profileData } = Astro.props;
---

<section class="py-16 sm:py-24 border-b border-zinc-200 dark:border-zinc-800/60">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col-reverse md:flex-row items-start md:items-center justify-between gap-8 sm:gap-12">
      <div class="flex-1 space-y-5">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>{profile.status}</span>
        </div>

        <!-- Heading & Location -->
        <div class="space-y-2">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
            Hi, I'm <span class="text-emerald-600 dark:text-emerald-400">{profile.name}</span>
          </h1>
          <p class="text-lg sm:text-xl md:text-2xl font-medium text-zinc-600 dark:text-zinc-400 flex flex-wrap items-center gap-x-2 gap-y-1">
            <span>{profile.title}</span>
            <span class="text-zinc-400 dark:text-zinc-600">·</span>
            <span class="inline-flex items-center gap-1.5 text-zinc-600 dark:text-zinc-400">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>{profile.location}</span>
            </span>
          </p>
        </div>

        <!-- Bio Narrative -->
        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
          {profile.bio}
        </p>

        <!-- Primary Call to Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 pt-2">
          <a
            href="#projects"
            class="px-5 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-sm transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950 inline-flex items-center gap-2"
          >
            <span>View Projects</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <a
            href="#contact"
            class="px-5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 font-medium text-sm text-zinc-800 dark:text-zinc-200 transition-colors inline-flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
          >
            <span>Get in Touch</span>
          </a>

          <a
            href="/resume.pdf"
            download
            class="px-5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 font-medium text-sm text-zinc-800 dark:text-zinc-200 transition-colors inline-flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
          >
            <svg class="w-4 h-4 text-zinc-500 dark:text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span>Download Resume</span>
          </a>
        </div>
      </div>

      <!-- Avatar with subtle gradient ring & fallback -->
      <div class="relative group shrink-0">
        <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-emerald-500 to-cyan-500 opacity-30 group-hover:opacity-60 blur transition duration-300"></div>
        <img
          src={user.avatar_url || 'https://github.com/itto0.png'}
          alt={`${profile.name} Avatar`}
          width="144"
          height="144"
          class="relative w-28 h-28 sm:w-36 sm:h-36 rounded-full border-2 border-white dark:border-zinc-900 object-cover shadow-lg"
          loading="eager"
          onerror="this.onerror=null; this.src='/favicon.svg';"
        />
      </div>
    </div>
  </div>
</section>
