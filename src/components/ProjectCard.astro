---
import type { EnrichedProject } from '../lib/github';
import { LANGUAGE_COLORS } from '../lib/github';

interface Props {
  project: EnrichedProject;
}

const { project } = Astro.props;
const langColor = LANGUAGE_COLORS[project.language] || LANGUAGE_COLORS.Other || '#71717a';
---

<article class="flex flex-col justify-between p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/50 dark:bg-zinc-900/40 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 transition-all duration-200 shadow-sm hover:shadow-md group">
  <div class="space-y-4">
    <!-- Header: Title, Language & Metrics -->
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
        {project.displayName}
      </h3>
      <div class="flex items-center gap-2 shrink-0">
        {project.language && project.language !== 'Unknown' && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
            <span class="w-2 h-2 rounded-full" style={`background-color: ${langColor};`} />
            <span>{project.language}</span>
          </span>
        )}
        <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400" aria-label={`${project.stars} stars`}>
          <svg class="w-3.5 h-3.5 text-amber-500 fill-current" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span>{project.stars}</span>
        </div>
        <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400" aria-label={`${project.forks} forks`}>
          <svg class="w-3.5 h-3.5 text-zinc-500 dark:text-zinc-400 fill-current" viewBox="0 0 16 16" aria-hidden="true">
            <path fill-rule="evenodd" d="M5 3.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm0 2.122a2.25 2.25 0 10-1.5 0v.878A2.25 2.25 0 005.75 8.5h1.5v2.128a2.251 2.251 0 101.5 0V8.5h1.5A2.25 2.25 0 0012.5 6.25v-.878a2.25 2.25 0 10-1.5 0v.878a.75.75 0 01-.75.75h-4.5A.75.75 0 015 6.25v-.878zm3.75 7.378a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm3-8a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
          </svg>
          <span>{project.forks}</span>
        </div>
      </div>
    </div>

    <!-- Engineering Narrative: Problem & Outcome -->
    <div class="space-y-3 text-sm">
      <div>
        <span class="font-semibold text-zinc-700 dark:text-zinc-300">Challenge:</span>
        <p class="text-zinc-600 dark:text-zinc-400 mt-0.5 leading-relaxed">
          {project.problem}
        </p>
      </div>
      <div>
        <span class="font-semibold text-emerald-700 dark:text-emerald-400">Outcome:</span>
        <p class="text-zinc-600 dark:text-zinc-400 mt-0.5 leading-relaxed">
          {project.outcome}
        </p>
      </div>
    </div>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 pt-2">
      {project.tags.map((tag) => (
        <span class="px-2 py-0.5 text-xs font-mono rounded bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <!-- Links -->
  <div class="flex items-center gap-4 pt-6 mt-4 border-t border-zinc-100 dark:border-zinc-800/60 text-sm font-medium">
    <a
      href={project.repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`View ${project.displayName} repository on GitHub`}
      class="inline-flex items-center gap-1.5 text-zinc-700 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
      </svg>
      <span>Repository</span>
    </a>

    {project.demoUrl && (
      <a
        href={project.demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`View ${project.displayName} live demo`}
        class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
        <span>Live Demo</span>
      </a>
    )}
  </div>
</article>
