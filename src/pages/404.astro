---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="404 — Page Not Found">
  <Navbar />
  <main class="flex-1 flex items-center justify-center py-24 px-4 text-center">
    <div class="space-y-4 max-w-md">
      <span class="font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">
        404 Error
      </span>
      <h1 class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100">
        Page Not Found
      </h1>
      <p class="text-zinc-600 dark:text-zinc-400 text-sm">
        The page you are looking for doesn't exist or has been moved.
      </p>
      <div class="pt-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-zinc-900 dark:bg-zinc-100 text-zinc-100 dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
        >
          Return Home
        </a>
      </div>
    </div>
  </main>
</Layout>
